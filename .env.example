# Supabase project settings (Project Settings > API). Both values are safe to
# expose in the browser; never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel > Settings > Environment Variables). Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# 64 hex characters: openssl rand -hex 32
ENCRYPTION_KEY=
# Meta app > Instagram > API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Any random string; enter the same value when registering the webhook in Meta
META_VERIFY_TOKEN=
